# NOTE: with docker compose, AVOID the '$' character in any value below. Compose
# runs variable substitution over this file, so a '$word' is read as a variable
# and blanked out (you'll see "variable is not set. Defaulting to a blank
# string."), silently corrupting the value. Use $-free secrets, or escape each
# '$' as '$$'. A bcrypt ADMIN_PASSWORD_HASH is full of '$' — see notes below.

# ─── Postiz database (the instance you are administering) ───────────────────
# Inside Docker, point these at the Postiz Postgres container on the shared
# network. Nothing here is hardcoded in the app.
PGHOST=postiz-postgres
PGPORT=5432
PGDATABASE=postiz
PGUSER=postiz
PGPASSWORD=change-me
# Optional: cap the pg pool size.
PGPOOLMAX=5

# ─── Admin login for THIS console (single operator) ─────────────────────────
ADMIN_USERNAME=admin
# Provide EITHER a bcrypt hash OR a plaintext password (set only one).
# Generate a hash:  node dist/tools/hashpw.js 'your-password'
# IMPORTANT (docker compose): a bcrypt hash contains '$' (e.g. $2b$10$...). You
# MUST escape each '$' as '$$' here, otherwise compose blanks it out:
#   ADMIN_PASSWORD_HASH=$$2b$$10$$....
ADMIN_PASSWORD_HASH=
# Simpler with docker compose: a plaintext password (pick one WITHOUT '$'),
# hashed in-memory at boot; fine for a single operator.
ADMIN_PASSWORD=

# Secret used to sign the session cookie. MUST be long & random in production.
# Use hex so it contains no '$':  openssl rand -hex 32
SESSION_SECRET=please-change-this-to-a-long-random-string

# ─── This app ───────────────────────────────────────────────────────────────
APP_PORT=8080
# Bind address. Keep on the internal network; NEVER expose publicly.
APP_HOST=0.0.0.0

# Where the append-only audit log is written (JSONL).
AUDIT_LOG=/app/data/audit.jsonl

# Where pre-delete pg_dump backups are written.
BACKUP_DIR=/app/backups

# When deleting a workspace, what to do with members left at zero memberships:
#   leave   = leave them as orphans (default, safer; shown in health panel)
#   cascade = also delete accounts whose SOLE membership was this workspace
#             (never deletes a shared account)
ORPHAN_POLICY=leave

# Set to "true" only in trusted local dev to allow http cookies. Set to
# "false" if you terminate TLS in front of the console.
INSECURE_COOKIES=true

# ─── Docker wiring ──────────────────────────────────────────────────────────
# Name of the EXISTING Postiz Docker network to join (see `docker network ls`).
POSTIZ_NETWORK=postiz_default
